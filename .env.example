# Copy to `.env.local` for local Vite dev (`npm run dev`).
# Never commit secrets. `VITE_*` values are exposed to the browser.

# --- Auth (required for signed-in trading UI) ---
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Backend API (exchange integrations) ---
# VITE_BACKEND_API_BASE=http://127.0.0.1:8787/api

# --- Optional dev without Supabase ---
# VITE_DEV_USER_ID=demo-user

# --- Android app / Google Play (Account → Android app) ---
# Omit VITE_ANDROID_PLAY_STORE_URL to keep placeholder mode (in-app “coming soon”).
# VITE_ANDROID_PACKAGE_NAME=group.sigflo.app
# VITE_ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=group.sigflo.app
# VITE_APP_VERSION=1.0.0

# --- Optional: affiliate signup links ---
# VITE_BYBIT_AFFILIATE_CODE=
# VITE_MEXC_AFFILIATE_CODE=
# VITE_BYBIT_AFFILIATE_SIGNUP_URL=
# VITE_MEXC_AFFILIATE_SIGNUP_URL=

# --- Optional: routing / deploy ---
# VITE_BASE=/
# VITE_APP_HOST=app
# VITE_AUTH_REDIRECT_ORIGIN=https://www.sigflo.group
