NODE_ENV=development
PORT=8787
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3999

# Supabase project URL (https://xxxx.supabase.co) — used for JWT verification (JWKS).
SUPABASE_URL=https://your-project.supabase.co

# Required for legacy HS256 session tokens. Supabase → Project Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=your-jwt-secret

# 64 hex chars (openssl rand -hex 32). Must match production if sharing the same database.
CREDENTIAL_ENCRYPTION_KEY=

# Supabase → Database → Connection string (Session pooler, port 5432).
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres

# Admin feedback dashboard + beta admin API — your Google sign-in email(s) and/or Supabase user UUID(s).
SIGFLO_BETA_ADMIN_EMAILS=you@example.com
SIGFLO_BETA_ADMIN_USER_IDS=
