# Copy to `.bridge.env` in the repo root (gitignored). Never commit real values.

# Slack bot token from your Slack app (Bot User OAuth Token)
SLACK_BOT_TOKEN=

# Slack DM channel ID for the bridge (starts with D)
SLACK_DM_CHANNEL=

# Optional: WhatsApp pairing (E.164 without +), for start-whatsapp.sh / whatsapp-poll.mjs
WHATSAPP_PHONE=

# Optional: scripts/slack-auto.mjs
OPENAI_API_KEY=
OPENCODE_API_KEY=
